{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "./dist",

        "target": "es2022",
        "module": "commonjs",
        "esModuleInterop": true,

        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*"]
}
